<Page x:Class="Trenia2.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Trenia2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница обуви"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Width="60" Height="60" Source="../Images/Icon.png"></Image>
            <TextBlock Text="Список обуви" VerticalAlignment="Center" Margin="10" FontSize="20" FontWeight="Bold"></TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Column="1">
            <TextBlock Text="{Binding CurrentUser.Fio}" VerticalAlignment="Center" Margin="10" FontSize="14" FontWeight="Bold"></TextBlock>
            <Button Margin="10" Content="Выйти" Click="VixodClick"  ></Button>
        </StackPanel>

        <WrapPanel Grid.Row="1" x:Name="FilterPanel">
            <TextBox Width="150" Margin="10" x:Name="PoiskBox" SelectionChanged="PoiskBox_SelectionChanged"></TextBox>
            <ComboBox Width="150" Margin="10" x:Name="SortBox" SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"></ComboBoxItem>
                <ComboBoxItem Content="По возрастанию товара"></ComboBoxItem>
                <ComboBoxItem Content="По убыванию товара"></ComboBoxItem>
            </ComboBox>
            <ComboBox Width="150" Margin="10" x:Name="PostBox" SelectionChanged="PostBox_SelectionChanged" DisplayMemberPath="Name"></ComboBox>
        </WrapPanel>

        <WrapPanel Grid.Row="2" >
            <Button Content="Добавить товар" x:Name="AddBtn" Click="AddBtn_Click" Margin="10"></Button>
            <Button Content="Удалить товар" x:Name="DeleteBtn" Click="DeleteBtn_Click"  Margin="10"></Button>
            <Button Content="Заказы" x:Name="OrdersBtn" Click="OrdersBtn_Click"  Margin="10"></Button>
        </WrapPanel>

        <ListView x:Name="ProductList" Grid.Row="3" HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ProductList_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Background="{Binding RowColor}" Padding="6">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="90"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="Black" BorderThickness="1" Background="White" Padding="6">
                                <Image Width="130" Height="90" Source="{Binding Photo, Converter={StaticResource ImagesConv}}"></Image>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap">
                                    <Run Text="{Binding IdCategoryNavigation.Category1}"></Run>
                                    <Run Text="|"></Run>
                                    <Run Text="{Binding NameTovar}"></Run>
                                </TextBlock>
                                <TextBlock FontSize="12" TextWrapping="Wrap">
    <Run Text="Описание товара:"></Run>
    <Run Text="{Binding Opisanie}"></Run>
                                </TextBlock>
                                <TextBlock FontSize="12" TextWrapping="Wrap">
<Run Text="Производитель:"></Run>
<Run Text="{Binding IdProizNavigation.Name}"></Run>
                                </TextBlock>
                                <TextBlock FontSize="12" TextWrapping="Wrap">
<Run Text="Поставщик:"></Run>
<Run Text="{Binding IdPostNavigation.Name}"></Run>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="Цена:"></TextBlock>
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="Red" TextDecorations="Strikethrough"
                                               Text="{Binding Price, StringFormat={}{0:f2}p.}"
                                               Visibility="{Binding HasDiscount, Converter={StaticResource BoolTiVis}}"></TextBlock>

                                    <TextBlock FontSize="12" TextWrapping="Wrap"
            Foreground="Black" 
            Text="{Binding MoneyDiscount, StringFormat={}{0:f2}p.}"
            Visibility="{Binding HasDiscount, Converter={StaticResource BoolTiVis}}"></TextBlock>

                                    <TextBlock FontSize="12" TextWrapping="Wrap"
Foreground="Black" 
Text="{Binding Price, StringFormat={}{0:f2}p.}"
Visibility="{Binding HasDiscount, Converter={StaticResource InverseToVis}}"></TextBlock>
                                </StackPanel>
                                <TextBlock FontSize="12" TextWrapping="Wrap">
<Run Text="ПостЕдиница измеренияавщик:"></Run>
<Run Text="{Binding IdEdIzmNavigation.EdIzm1}"></Run>
                                </TextBlock>
                                <TextBlock FontSize="12" TextWrapping="Wrap">
<Run Text="Количество на складе:"></Run>
<Run Text="{Binding KolSklad}"></Run>
                                </TextBlock>
                            </StackPanel>

                            <Border BorderBrush="Black" BorderThickness="1" Background="White" Padding="6" Grid.Column="2"
                                    >
                                <StackPanel>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="Скидка:"></TextBlock>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Sale, StringFormat={}{0:f2}%}"></TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
