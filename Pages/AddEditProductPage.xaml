<Page x:Class="Trenia2.Pages.AddEditProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Trenia2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница редактирования товара"
      Background="White">

    <Grid>
        <ScrollViewer>
            <StackPanel Width="250">

                <TextBlock Margin="20" FontSize="20" FontWeight="Bold" Text="{Binding NameStr}"></TextBlock>

                <TextBlock Margin="10" FontSize="12"  Text="ID:"></TextBlock>
                <TextBox x:Name="IdBox"></TextBox>

                <TextBlock Margin="10" FontSize="12"  Text="Фото:"></TextBlock>
                <StackPanel>
                    <Image Width="120" Height="90" x:Name="ImagesBox"></Image>
                    <Button Width="120" Content="Выбрать фото" Click="SavePhoto"></Button>
                </StackPanel>

                <TextBlock Margin="10" FontSize="12"  Text="Описание товара:"></TextBlock>
                <TextBox x:Name="Opisanie"></TextBox>

                <TextBlock Margin="10" FontSize="12"  Text="Скидка:" ></TextBlock>
                <TextBox x:Name="SaleBox" Text="0"></TextBox>

                <TextBlock Margin="10" FontSize="12"  Text="Количество на складе:"></TextBlock>
                <TextBox x:Name="KolSkladBox"></TextBox>

                <TextBlock Margin="10" FontSize="12"  Text="Цена:"></TextBlock>
                <TextBox x:Name="Price"></TextBox>

                <TextBlock Margin="10" FontSize="12"  Text="Наименование:"></TextBlock>
                <TextBox x:Name="NameBox"></TextBox>


                <TextBlock Margin="10" FontSize="12"  Text="Категория:"></TextBlock>
                <ComboBox x:Name="CategoryBox" DisplayMemberPath="Category1" SelectedValuePath="IdCategory"></ComboBox>

                <TextBlock Margin="10" FontSize="12"  Text="Поставщик:"></TextBlock>
                <ComboBox x:Name="PostBox" DisplayMemberPath="Name" SelectedValuePath="IdPost"></ComboBox>

                <TextBlock Margin="10" FontSize="12"  Text="Производитель:"></TextBlock>
                <ComboBox x:Name="ProizBox" DisplayMemberPath="Name" SelectedValuePath="IdProizv"></ComboBox>

                <TextBlock Margin="10" FontSize="12"  Text="Единица измерения:"></TextBlock>
                <ComboBox x:Name="EdIzmBox" DisplayMemberPath="EdIzm1" SelectedValuePath="IdEdIzm"></ComboBox>

                <Button Content="Сохранить" Click="SaveBtn" Margin="10"></Button>
                <Button Content="Назад" Click="NazadClick" Margin="10"></Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
