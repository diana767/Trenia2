<Page x:Class="Trenia2.Pages.AddEditOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Trenia2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница редактирования заказа"  Background="White">

    <Grid>
        <ScrollViewer>
            <StackPanel Width="250">

                <TextBlock Margin="20" FontSize="20" FontWeight="Bold" Text="{Binding NameStr}"></TextBlock>

                <TextBlock Margin="10" FontSize="12"  Text="Код заказа:"></TextBlock>
                <TextBox x:Name="KodBox"></TextBox>
                
                <TextBlock Margin="10" FontSize="12"  Text="Статус заказа:"></TextBlock>
                <ComboBox x:Name="StatusBox" DisplayMemberPath="Status1" SelectedValuePath="IdStatus"></ComboBox>

                <TextBlock Margin="10" FontSize="12"  Text="Адрес заказа:"></TextBlock>
                <ComboBox x:Name="AdresBox" DisplayMemberPath="Adres" SelectedValuePath="IdPuncta"></ComboBox>

                <TextBlock Margin="10" FontSize="12"  Text="Дата заказа:"></TextBlock>
                <DatePicker x:Name="DataZak"></DatePicker>

                <TextBlock Margin="10" FontSize="12"  Text="Дата доставки:"></TextBlock>
                <DatePicker x:Name="DataDost"></DatePicker>

                <Button Content="Сохранить" Click="SaveBtn" Margin="10"></Button>
                <Button Content="Назад" Click="NazadClick" Margin="10"></Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
