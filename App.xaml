<Application x:Class="Trenia2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Trenia2"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#00FA9A"></SolidColorBrush>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary" Color="#7FFF00"></SolidColorBrush>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foregraund" Color="#FFFFFF"></SolidColorBrush>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Foregraund" Color="#FFFFFF"></SolidColorBrush>

                    <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Times New Roman"></Setter>
                    </Style>

                    <local:BooleanToVisibilityConverters x:Key="BoolTiVis"></local:BooleanToVisibilityConverters>
                    <local:InverseBooleanToVisibilityConverters x:Key="InverseToVis"></local:InverseBooleanToVisibilityConverters>
                    <local:ImagesConverters x:Key="ImagesConv"></local:ImagesConverters>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
